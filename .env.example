# Optional. Offline mode needs no credentials. Copy to .env and restart the app.
# Any provider offering the OpenAI-compatible /chat/completions endpoint can be used.
PROMO_API_BASE=https://openrouter.ai/api/v1
PROMO_API_KEY=
PROMO_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# This free NVIDIA endpoint is for public/non-confidential inputs only.
# Explicit owner authorization can override the default input restriction.
# The original material remains confidential; this flag never marks it public.
PROMO_ALLOW_CONFIDENTIAL=0

# Optional separate Groq route for confidential assignment inputs.
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local model. Install/pull a model separately; the app never downloads one.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
